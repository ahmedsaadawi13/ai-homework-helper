# FILE: /.env.example
# AI Homework Helper - Environment Configuration

# Application
APP_NAME="AI Homework Helper"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_NAME=ai_homework_helper
DB_USER=root
DB_PASS=

# Session
SESSION_LIFETIME=7200

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Timezone
APP_TIMEZONE=UTC

# AI Settings (Mock)
AI_ENABLED=true
AI_MAX_REQUESTS_PER_MONTH=1000
